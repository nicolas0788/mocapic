# =============================================================================
# .env.example – PLANTILLA DE VARIABLES DE ENTORNO PARA MOCAPIC
# =============================================================================
# ⚙️ ¿Qué es este archivo?
# Este archivo sirve como referencia para crear el archivo `.env` real.
# 
# ⚠️ Importante:
# - NO incluir datos reales de contraseñas aquí.
# - Cada desarrollador debe copiar este archivo y renombrarlo como `.env`.
# - Docker Compose usa `.env` para configurar los servicios definidos
#   en docker-compose.yml (MariaDB, PHP, phpMyAdmin).
#
# Ejemplo:
#   cp .env.example .env
#   (Luego edita .env con tus valores reales)
# =============================================================================



# =========================
# 🗄️  CONFIGURACIÓN DE LA BASE DE DATOS (SERVICIO "db")
# =========================

# Nombre de la base de datos que se creará automáticamente en el contenedor de MariaDB.
# En tu entorno local puede ser algo como: mocapic, textil, pruebas, etc.
MYSQL_DATABASE=nombre_de_tu_base

# Usuario no administrador que se creará dentro de MariaDB.
# Este usuario es el que tu aplicación PHP usará para conectarse a la base.
MYSQL_USER=usuario_local

# Contraseña del usuario anterior (elige una segura).
MYSQL_PASSWORD=contraseña_segura

# Contraseña del usuario root (administrador total de MariaDB).
# Solo se usa en desarrollo o mantenimiento, nunca en producción.
MYSQL_ROOT_PASSWORD=contraseña_root



# =========================
# 🧩  CONFIGURACIÓN DE LA APP PHP/APACHE (SERVICIO "app")
# =========================

# Entorno de ejecución de la app.
# Valores posibles: local | staging | production
APP_ENV=local

# Host de la base de datos visto desde PHP dentro de Docker.
# No usar "localhost", sino el nombre del servicio declarado en docker-compose.yml (por defecto: db).
DB_HOST=db

# Nombre de la base a la que se conectará PHP (debe coincidir co
